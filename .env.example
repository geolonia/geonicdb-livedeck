# GeonicDB ライブデモ用 API キー（origin 制限あり: localhost:8745 / geolonia.github.io）
# ローカル開発では .env にコピーして実キーを設定する（.env は gitignore 済み）。
# デッキ全体で 1 つの統合キーを使う。サーバ側のキー／ポリシー名は geonicdb-livedeck-deck
# （統合ポリシー）。発行手順は README「セットアップ §0」を参照。
VITE_GEONICDB_KEY=gdb_xxxxxxxxxxxxxxxx

# FOSS4G Hiroshima 2026 会場投稿(Contribution)専用キー。テナント foss4g_hiroshima_2026
# (ENTERPRISE契約・200名負荷試験済み)向け。デッキ共通の VITE_GEONICDB_KEY とは別物。
# Secrets Manager: geonicdb/foss4g-hiroshima-2026/contribution-key
VITE_GEONICDB_CONTRIBUTION_KEY=gdb_xxxxxxxxxxxxxxxx

# Geolonia Maps の API キー（任意。未設定なら YOUR-API-KEY のままで localhost / github.io は動作）
VITE_GEOLONIA_API_KEY=YOUR-API-KEY
